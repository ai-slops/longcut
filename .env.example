# Copy to .env locally. Never commit real credentials.
# ChatGPT subscription login is separate and is performed in the Agent workspace.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Choose a vision-capable model supported by your compatible endpoint.
OPENAI_MODEL=
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_MAX_OUTPUT_TOKENS=8192
# Use max_tokens only when your provider requires the older parameter.
OPENAI_TOKEN_PARAMETER=max_completion_tokens
